<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noto.App.ViewModels"
             x:Class="Noto.App.Views.OnboardingView"
             x:DataType="vm:OnboardingViewModel">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20" MaxWidth="520" Margin="24">
    <TextBlock Text="{Binding Question}" Classes="title" TextWrapping="Wrap" TextAlignment="Center" />
    <TextBlock Text="Noto asks about every task you didn't finish, so nothing rots silently." Classes="secondary"
               TextAlignment="Center" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
      <Button Classes="key" Padding="24,12" Content="Work" Command="{Binding PickCommand}" CommandParameter="Work" />
      <Button Classes="key" Padding="24,12" Content="Personal" Command="{Binding PickCommand}" CommandParameter="Personal" />
      <Button Classes="key" Padding="24,12" Content="Both" Command="{Binding PickCommand}" CommandParameter="Both" />
    </StackPanel>
  </StackPanel>
</UserControl>
