<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.InsightsView"
  x:DataType="vm:InsightsViewModel"
>
  <ScrollViewer>
    <StackPanel MaxWidth="760" Margin="24,8,24,24" Spacing="18" HorizontalAlignment="Stretch">
      <TextBlock
        Text="{Binding StreakText}"
        Classes="secondary"
        IsVisible="{Binding StreakText.Length}"
        ToolTip.Tip="Consecutive days with at least one planned item finished."
      />

      <!-- Unlocked insights: a sentence, backed by a chart. -->
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InsightCard">
            <Border
              Classes="panel appear"
              Padding="20"
              Margin="0,0,0,12"
              AutomationProperties.Name="{Binding Headline}"
            >
              <StackPanel Spacing="12">
                <TextBlock
                  Text="{Binding Headline}"
                  FontSize="16"
                  FontWeight="SemiBold"
                  TextWrapping="Wrap"
                />
                <TextBlock
                  Text="{Binding Detail}"
                  Classes="secondary"
                  TextWrapping="Wrap"
                  IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                />

                <!-- A trend is a shape, not a list: one bar per sample, on a shared baseline. -->
                <ItemsControl
                  ItemsSource="{Binding Sparkline}"
                  IsVisible="{Binding HasSparkline}"
                  HorizontalAlignment="Left"
                  Margin="0,2,0,0"
                >
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InsightRow">
                      <Border
                        Width="16"
                        Height="{Binding Fraction, Converter={x:Static v:RowConverters.SparkHeight}}"
                        CornerRadius="2"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource AccentBrush}"
                        ToolTip.Tip="{Binding Label}"
                      />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InsightRow">
                      <Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="12" Margin="0,3">
                        <TextBlock
                          Text="{Binding Label}"
                          Classes="secondary"
                          TextTrimming="CharacterEllipsis"
                        />
                        <ProgressBar
                          Grid.Column="1"
                          Minimum="0"
                          Maximum="1"
                          Value="{Binding Fraction}"
                          MinWidth="60"
                          VerticalAlignment="Center"
                        />
                        <TextBlock
                          Grid.Column="2"
                          Text="{Binding Value}"
                          Classes="hint"
                          TextTrimming="CharacterEllipsis"
                        />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="6"
                  IsVisible="{Binding Suggestion, Converter={x:Static ObjectConverters.IsNotNull}}"
                >
                  <PathIcon
                    Data="{v:Icon arrow-right}"
                    Width="14"
                    Height="14"
                    Foreground="{DynamicResource LinkBrush}"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{Binding Suggestion}"
                    Foreground="{DynamicResource LinkBrush}"
                    TextWrapping="Wrap"
                  />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!--
        Before there is enough history, show the catalogue greyed with a progress-to-unlock meter. A
        sentence on an otherwise empty page teaches nothing (docs/07 §8.2).
      -->
      <StackPanel IsVisible="{Binding HasLocked}" Spacing="8">
        <TextBlock Text="STILL LEARNING" Classes="section" />
        <TextBlock Text="{Binding LearningText}" Classes="hint" FontSize="12" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Locked}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LockedInsight">
              <Border Classes="card" Margin="0,0,0,8" Opacity="0.7">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="8">
                    <TextBlock
                      Text="{Binding Title}"
                      FontSize="14"
                      FontWeight="Medium"
                      TextWrapping="Wrap"
                    />
                    <ProgressBar
                      Minimum="0"
                      Maximum="1"
                      Value="{Binding Progress}"
                      Width="220"
                      HorizontalAlignment="Left"
                    />
                  </StackPanel>
                  <TextBlock
                    Grid.Column="1"
                    Text="{Binding ProgressText}"
                    Classes="hint"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Days of history gathered / needed before this insight appears."
                  />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding HasOldest}" Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="OLDEST OPEN ITEMS" Classes="section" VerticalAlignment="Center" />
          <Button
            Grid.Column="1"
            Classes="info"
            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenHelpCommand}"
            CommandParameter="{x:Static vm:HelpTopicIds.Carry}"
            AutomationProperties.Name="About age and carry"
          >
            <PathIcon Data="{v:Icon info}" />
          </Button>
        </Grid>
        <ItemsControl ItemsSource="{Binding OldestOpen}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InsightRow">
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="hint" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
