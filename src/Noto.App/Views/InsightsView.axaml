<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.InsightsView"
  x:DataType="vm:InsightsViewModel"
>
  <ScrollViewer>
    <StackPanel MaxWidth="720" Margin="24" Spacing="16" HorizontalAlignment="Stretch">
      <TextBlock
        Text="{Binding StreakText}"
        Classes="secondary"
        IsVisible="{Binding StreakText.Length}"
        ToolTip.Tip="A completion streak — consecutive days on which you finished at least one planned item."
      />
      <TextBlock
        Text="{Binding EmptyText}"
        Classes="secondary"
        TextWrapping="Wrap"
        IsVisible="{Binding HasEmpty}"
      />

      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InsightCard">
            <Border
              Classes="panel appear"
              Padding="20"
              Margin="0,0,0,12"
              AutomationProperties.Name="{Binding Headline}"
            >
              <StackPanel Spacing="10">
                <TextBlock
                  Text="{Binding Headline}"
                  FontSize="16"
                  FontWeight="SemiBold"
                  TextWrapping="Wrap"
                />
                <TextBlock
                  Text="{Binding Detail}"
                  Classes="secondary"
                  TextWrapping="Wrap"
                  IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InsightRow">
                      <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="12" Margin="0,3">
                        <TextBlock
                          Text="{Binding Label}"
                          Classes="secondary"
                          TextTrimming="CharacterEllipsis"
                        />
                        <ProgressBar
                          Grid.Column="1"
                          Minimum="0"
                          Maximum="1"
                          Value="{Binding Fraction}"
                          MinWidth="60"
                          VerticalAlignment="Center"
                        />
                        <TextBlock
                          Grid.Column="2"
                          Text="{Binding Value}"
                          Classes="hint"
                          TextTrimming="CharacterEllipsis"
                        />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="6"
                  IsVisible="{Binding Suggestion, Converter={x:Static ObjectConverters.IsNotNull}}"
                >
                  <PathIcon
                    Data="{v:Icon arrow-right}"
                    Width="14"
                    Height="14"
                    Foreground="{DynamicResource LinkBrush}"
                    VerticalAlignment="Top"
                    Margin="0,2,0,0"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{Binding Suggestion}"
                    Foreground="{DynamicResource LinkBrush}"
                    TextWrapping="Wrap"
                  />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding HasOldest}" Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock
            Text="OLDEST OPEN ITEMS"
            Classes="section"
            VerticalAlignment="Center"
            ToolTip.Tip="Items you have been carrying the longest. Age is a fact; carry is what pressure reacts to."
          />
          <Button
            Grid.Column="1"
            Classes="info"
            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenHelpCommand}"
            CommandParameter="{x:Static vm:HelpTopicIds.Carry}"
            AutomationProperties.Name="About age and carry"
            ToolTip.Tip="What age, carry and defers mean"
          >
            <PathIcon Data="{v:Icon info}" />
          </Button>
        </Grid>
        <ItemsControl ItemsSource="{Binding OldestOpen}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InsightRow">
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="hint" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
