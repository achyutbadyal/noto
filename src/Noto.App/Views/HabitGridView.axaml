<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.HabitGridView"
  x:DataType="vm:HabitGridViewModel"
>
  <ScrollViewer>
    <StackPanel Margin="24,8,24,16" Spacing="12">
      <v:PromptBar DataContext="{Binding Decisions}" />
      <TextBlock
        Text="No habits yet. A habit is a recurring item that is skipped, not carried, when missed."
        Classes="secondary"
        IsVisible="{Binding HasNoHabits}"
        TextWrapping="Wrap"
      />

      <StackPanel>
        <!-- day labels line up with the cells below (same columns, same 30px cells) -->
        <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="12" Margin="24,0,12,4">
          <ItemsControl Grid.Column="1" ItemsSource="{Binding DayLabels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Classes="hint" Width="30" TextAlignment="Center" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <ItemsControl ItemsSource="{Binding Habits}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HabitRowViewModel">
              <Border
                Classes="row"
                Classes.focused="{Binding IsFocused}"
                Padding="12,4"
                AutomationProperties.Name="{Binding AutomationName}"
                ClipToBounds="True"
              >
                <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="12">
                  <TextBlock
                    Text="{Binding Name}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                  />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HabitCellViewModel">
                        <Button
                          Classes="habitCell"
                          ToolTip.Tip="{Binding Description}"
                          AutomationProperties.Name="{Binding Description}"
                          IsEnabled="{Binding IsToday}"
                          Command="{Binding $parent[UserControl].((vm:HabitGridViewModel)DataContext).ToggleTodayCommand}"
                          CommandParameter="{Binding $parent[ItemsControl].((vm:HabitRowViewModel)DataContext)}"
                        >
                          <Border
                            Classes="habit"
                            Classes.done="{Binding IsDone}"
                            Classes.off="{Binding !IsScheduled}"
                          />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock
                    Grid.Column="2"
                    Text="{Binding StreakText}"
                    Classes="secondary"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                  />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <v:SectionsList DataContext="{Binding}" MinHeight="160" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
