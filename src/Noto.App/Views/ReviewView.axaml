<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.ReviewView"
  x:DataType="vm:ReviewViewModel"
>
  <ScrollViewer>
    <Border
      Classes="panel appear"
      MaxWidth="680"
      Margin="24"
      Padding="28"
      VerticalAlignment="Top"
      HorizontalAlignment="Center"
    >
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding Greeting}" Classes="displaySmall" TextWrapping="Wrap" />
          <TextBlock
            Grid.Column="1"
            Text="{Binding ProgressText}"
            Classes="secondary"
            VerticalAlignment="Top"
          />
          <Button
            Grid.Column="2"
            Classes="info"
            VerticalAlignment="Top"
            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenHelpCommand}"
            CommandParameter="{x:Static vm:HelpTopicIds.Review}"
            AutomationProperties.Name="About the morning review"
          >
            <PathIcon Data="{v:Icon info}" />
          </Button>
        </Grid>
        <TextBlock
          Text="{Binding DayNote, StringFormat='Yesterday you wrote: {0}'}"
          Classes="secondary"
          TextWrapping="Wrap"
          IsVisible="{Binding HasDayNote}"
        />
        <Separator />

        <!-- the current card. It leaves toward the decision, so the motion is the confirmation. -->
        <Border
          Classes="exit"
          Margin="{Binding ExitDirection, Converter={x:Static v:RowConverters.ExitMargin}}"
          Opacity="{Binding ExitDirection, Converter={x:Static v:RowConverters.ExitOpacity}}"
        >
          <StackPanel
            Spacing="6"
            IsVisible="{Binding !IsComplete}"
            AutomationProperties.Name="{Binding CurrentTitle}"
          >
            <TextBlock
              Text="{Binding CurrentTitle}"
              FontSize="22"
              FontWeight="SemiBold"
              TextWrapping="Wrap"
            />
            <TextBlock Text="{Binding CurrentDetail}" Classes="secondary" TextWrapping="Wrap" />
            <TextBlock
              Text="{Binding Current.Decision, StringFormat='Decided: {0}'}"
              Classes="hint"
              IsVisible="{Binding Current.IsDecided}"
            />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasSuggestion}">
              <PathIcon
                Data="{v:Icon sparkle}"
                Width="14"
                Height="14"
                Foreground="{DynamicResource LinkBrush}"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
              />
              <TextBlock
                Grid.Column="1"
                Text="{Binding SuggestionText}"
                Foreground="{DynamicResource LinkBrush}"
                TextWrapping="Wrap"
              />
            </Grid>
          </StackPanel>
        </Border>
        <StackPanel Spacing="6" IsVisible="{Binding IsComplete}">
          <TextBlock Text="All decided." FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Press Esc to start the day." Classes="secondary" />
        </StackPanel>

        <!-- one key per decision; the same keys work on the keyboard -->
        <WrapPanel IsVisible="{Binding !IsComplete}" ItemSpacing="8" LineSpacing="8">
          <Button
            Classes="accent"
            Padding="12,6"
            Command="{Binding PressCommand}"
            CommandParameter="t"
          >
            <TextBlock Text="{Binding KeepLabel, StringFormat='T  {0}'}" />
          </Button>
          <Button
            Classes="key"
            Padding="12,6"
            Command="{Binding PressCommand}"
            CommandParameter="d"
          >
            <TextBlock Text="D  Defer…" />
          </Button>
          <Button
            Classes="key"
            Padding="12,6"
            Command="{Binding PressCommand}"
            CommandParameter="s"
          >
            <TextBlock Text="S  Someday" />
          </Button>
          <Button
            Classes="key"
            Padding="12,6"
            Command="{Binding PressCommand}"
            CommandParameter="b"
          >
            <TextBlock Text="B  Break down" />
          </Button>
          <Button
            Classes="key"
            Padding="12,6"
            Command="{Binding PressCommand}"
            CommandParameter="w"
          >
            <TextBlock Text="W  Waiting on…" />
          </Button>
          <Button
            Classes="key"
            Padding="12,6"
            Command="{Binding PressCommand}"
            CommandParameter="x"
          >
            <TextBlock Text="X  Drop" />
          </Button>
          <Button
            Classes="key"
            Padding="12,6"
            Command="{Binding PressCommand}"
            CommandParameter="a"
          >
            <TextBlock Text="{Binding DoneLabel, StringFormat='A  {0}'}" />
          </Button>
        </WrapPanel>

        <TextBlock
          Text="{Binding Message}"
          Classes="error"
          TextWrapping="Wrap"
          IsVisible="{Binding HasMessage}"
        />
        <v:PromptBar DataContext="{Binding Decisions}" />

        <!-- the rest of the queue -->
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReviewEntry">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2" ColumnSpacing="8">
                <TextBlock
                  Text="{Binding Row.Title}"
                  Classes="secondary"
                  TextTrimming="CharacterEllipsis"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="{Binding Decision}"
                  Classes="hint"
                  IsVisible="{Binding IsDecided}"
                />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator />
        <!-- live capacity -->
        <Grid
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="12"
          IsVisible="{Binding Capacity, Converter={x:Static ObjectConverters.IsNotNull}}"
        >
          <TextBlock Text="Today so far" Classes="secondary" VerticalAlignment="Center" />
          <ProgressBar
            Grid.Column="1"
            Minimum="0"
            Maximum="100"
            Value="{Binding Capacity.Percent}"
            MinWidth="60"
            Classes.over="{Binding Capacity.IsOver}"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding Capacity.AutomationName}"
          />
          <TextBlock Grid.Column="2" Text="{Binding Capacity.Text}" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
          <Button
            Classes="key"
            Padding="12,6"
            Command="{Binding KeepAllCommand}"
            IsVisible="{Binding !IsComplete}"
          >
            <TextBlock Text="{Binding KeepAllLabel}" />
          </Button>
          <TextBlock
            Grid.Column="1"
            Text="{Binding KeepAllText}"
            Classes="secondary"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            IsVisible="{Binding HasKeepAll}"
          />
          <Button Grid.Column="2" Command="{Binding UndoLastCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Undo" />
              <Border Classes="kbd">
                <TextBlock Text="⌘Z" />
              </Border>
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Command="{Binding SkipCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding IsComplete, Converter={x:Static v:RowConverters.CloseLabel}}" />
              <Border Classes="kbd">
                <TextBlock Text="Esc" />
              </Border>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
