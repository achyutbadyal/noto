<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:l="using:Noto.App.Logic"
  xmlns:s="using:Noto.App.Services"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.InspectorView"
  x:DataType="vm:InspectorViewModel"
>
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="14">
      <TextBlock
        Text="Select an item to see its details."
        Classes="hint"
        TextWrapping="Wrap"
        IsVisible="{Binding !HasItem}"
      />

      <StackPanel Spacing="14" IsVisible="{Binding HasItem}">
        <StackPanel Spacing="3">
          <TextBlock
            Text="{Binding Title}"
            FontSize="18"
            FontWeight="SemiBold"
            TextWrapping="Wrap"
          />
          <TextBlock Text="{Binding ScheduleText}" Classes="secondary" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StateText}" Classes="hint" />
        </StackPanel>

        <!-- the three numbers -->
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="THIS ITEM" Classes="section" VerticalAlignment="Center" />
            <Button
              Grid.Column="1"
              Classes="info"
              Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenHelpCommand}"
              CommandParameter="{x:Static vm:HelpTopicIds.Carry}"
              AutomationProperties.Name="About age, carry and defers"
            >
              <PathIcon Data="{v:Icon info}" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="*,*,*" AutomationProperties.Name="Age, carry and defers">
            <StackPanel Spacing="2">
              <TextBlock
                Text="AGE"
                Classes="section"
                ToolTip.Tip="Days since it was created. Nothing escalates on age alone."
              />
              <TextBlock Text="{Binding AgeText}" FontSize="16" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock
                Text="CARRY"
                Classes="section"
                ToolTip.Tip="Planned days that passed with this undone — what pressure reacts to."
              />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{v:Icon carry}" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CarryText}" FontSize="16" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock
                Text="DEFERS"
                Classes="section"
                ToolTip.Tip="Times you deliberately pushed it later."
              />
              <TextBlock Text="{Binding DefersText}" FontSize="16" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- editable attributes: each change is a real command, so it lands in the activity log below -->
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock
              Text="EDIT"
              Classes="section"
              VerticalAlignment="Center"
              ToolTip.Tip="Recorded in the log below, and undone with ⌘Z."
            />
            <Button
              Grid.Column="1"
              Classes="info"
              Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenHelpCommand}"
              CommandParameter="{x:Static vm:HelpTopicIds.Editing}"
              AutomationProperties.Name="About editing and deleting"
            >
              <PathIcon Data="{v:Icon info}" />
            </Button>
          </Grid>
          <Grid
            ColumnDefinitions="84,*"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="8"
            RowSpacing="8"
          >
            <TextBlock Text="Title" Classes="secondary" VerticalAlignment="Center" />
            <TextBox
              Grid.Column="1"
              Text="{Binding TitleEdit, Mode=TwoWay}"
              KeyDown="OnTitleKeyDown"
              LostFocus="OnTitleLostFocus"
              AutomationProperties.Name="Title"
            />

            <TextBlock Grid.Row="1" Text="Time" Classes="secondary" VerticalAlignment="Center" />
            <ComboBox
              Grid.Row="1"
              Grid.Column="1"
              ItemsSource="{Binding Estimates}"
              SelectedItem="{Binding Estimate, Mode=TwoWay}"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="Estimate"
            />

            <TextBlock
              Grid.Row="2"
              Text="Priority"
              Classes="secondary"
              VerticalAlignment="Center"
            />
            <ComboBox
              Grid.Row="2"
              Grid.Column="1"
              ItemsSource="{Binding Priorities}"
              SelectedItem="{Binding Priority, Mode=TwoWay}"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="Priority"
              ToolTip.Tip="1 is highest."
            />

            <TextBlock Grid.Row="3" Text="When" Classes="secondary" VerticalAlignment="Center" />
            <ComboBox
              Grid.Row="3"
              Grid.Column="1"
              ItemsSource="{Binding Whens}"
              SelectedItem="{Binding When, Mode=TwoWay}"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="When"
            />

            <TextBlock Grid.Row="4" Text="Due" Classes="secondary" VerticalAlignment="Center" />
            <ComboBox
              Grid.Row="4"
              Grid.Column="1"
              ItemsSource="{Binding Dues}"
              SelectedItem="{Binding Due, Mode=TwoWay}"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="Due date"
            />

            <TextBlock
              Grid.Row="5"
              Text="Day part"
              Classes="secondary"
              VerticalAlignment="Center"
            />
            <ComboBox
              Grid.Row="5"
              Grid.Column="1"
              ItemsSource="{Binding TimesOfDay}"
              SelectedItem="{Binding TimeOfDay, Mode=TwoWay}"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="Time of day"
            />

            <TextBlock
              Grid.Row="6"
              Text="Waiting on"
              Classes="secondary"
              VerticalAlignment="Center"
            />
            <TextBox
              Grid.Row="6"
              Grid.Column="1"
              Text="{Binding WaitingOn, Mode=TwoWay}"
              Watermark="Nobody"
              KeyDown="OnWaitingKeyDown"
              LostFocus="OnWaitingLostFocus"
              AutomationProperties.Name="Waiting on"
              ToolTip.Tip="Setting this moves the item to the Waiting on section."
            />
          </Grid>
          <TextBlock
            Text="{Binding Error}"
            Classes="error"
            TextWrapping="Wrap"
            IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
        </StackPanel>

        <!-- stuck prompt: intervention, not punishment -->
        <Border Classes="raised" Padding="12" IsVisible="{Binding ShowStuckPrompt}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
              <PathIcon
                Data="{v:Icon stuck}"
                Width="14"
                Height="14"
                Foreground="{DynamicResource PressureStaleBrush}"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
              />
              <TextBlock Grid.Column="1" Text="{Binding StuckPromptText}" TextWrapping="Wrap" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Reasons}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StuckReasonOption">
                  <Button
                    Classes="key"
                    Content="{Binding Label}"
                    Padding="10,4"
                    Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).ChooseOptionCommand}"
                    CommandParameter="{Binding}"
                  />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
              Text="{Binding FixPrompt}"
              Foreground="{DynamicResource LinkBrush}"
              TextWrapping="Wrap"
              IsVisible="{Binding HasFix}"
            />
            <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasFix}">
              <Button Content="Now · 25 min" Command="{Binding MakeNowCommand}" Margin="0,0,8,6" />
              <Button
                Content="First thing tomorrow"
                Command="{Binding ScheduleTomorrowCommand}"
                Margin="0,0,8,6"
              />
            </WrapPanel>
          </StackPanel>
        </Border>
        <v:PromptBar DataContext="{Binding Decisions}" />

        <StackPanel Spacing="4" IsVisible="{Binding HasLinks}">
          <TextBlock Text="LINKS" Classes="section" />
          <ItemsControl ItemsSource="{Binding Links}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="s:LinkLine">
                <StackPanel Spacing="5" Margin="0,8,0,4">
                  <Border Classes="hairline" Margin="0,0,0,8" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Provider}" Classes="hint" FontSize="11" />
                    <Button
                      Grid.Column="1"
                      Content="Open"
                      Padding="8,2"
                      FontSize="12"
                      Tag="{Binding Url}"
                      Click="OnOpenLinkClick"
                      AutomationProperties.Name="Open link"
                    />
                  </Grid>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock
                    Text="{Binding Subtitle}"
                    Classes="secondary"
                    IsVisible="{Binding HasSubtitle}"
                    TextTrimming="CharacterEllipsis"
                  />
                  <ItemsControl ItemsSource="{Binding Facts}" IsVisible="{Binding HasFacts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="4" LineSpacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Border Classes="chip">
                          <TextBlock Text="{Binding}" FontSize="11" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock
                    Text="{Binding Snippet}"
                    Classes="secondary"
                    FontSize="12"
                    TextWrapping="Wrap"
                    IsVisible="{Binding HasSnippet}"
                  />
                  <TextBlock
                    Text="{Binding Author, StringFormat='by {0}'}"
                    Classes="hint"
                    FontSize="11"
                    IsVisible="{Binding HasAuthor}"
                  />
                  <TextBlock
                    Text="{Binding Status}"
                    Classes="hint"
                    TextWrapping="Wrap"
                    IsVisible="{Binding HasStatus}"
                  />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="NOTES" Classes="section" />
          <TextBox
            Text="{Binding Notes, Mode=TwoWay}"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="64"
            Watermark="Markdown notes"
            LostFocus="OnNotesLostFocus"
            AutomationProperties.Name="Notes"
          />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding HasSubtasks}">
          <TextBlock
            Text="{Binding ContainerProgress, StringFormat='SUBTASKS · {0}'}"
            Classes="section"
          />
          <ItemsControl ItemsSource="{Binding Subtasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ItemRowViewModel">
                <v:ItemRowView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding HasLife}">
          <TextBlock Text="LIFE OF THIS ITEM" Classes="section" />
          <ItemsControl ItemsSource="{Binding Life}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="l:LifeLine">
                <Grid ColumnDefinitions="56,*" Margin="0,2">
                  <TextBlock Text="{Binding DayText}" Classes="hint" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Delete is a soft delete: undoable, and recoverable from Settings -->
        <StackPanel Spacing="8">
          <Border Classes="hairline" />
          <Button
            Classes="danger"
            Content="Delete task"
            HorizontalAlignment="Left"
            Command="{Binding DeleteCommand}"
            AutomationProperties.Name="Delete task"
            ToolTip.Tip="⌘Z brings it straight back."
          />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
