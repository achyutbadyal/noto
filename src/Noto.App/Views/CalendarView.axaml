<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.CalendarView"
  x:DataType="vm:CalendarViewModel"
>
  <!--
    Week and Month scopes of the home screen (the shell header switches them). Month (chips, a glance at the shape of the weeks) and Week
    (seven day columns of full cards: the kanban reading). Both are drop targets for planning, and the
    side tray holds what has no day yet, or whose day has passed, so a card can be dragged out of it.
  -->
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,8,24,16">
    <v:PromptBar Grid.Row="0" DataContext="{Binding Decisions}" Margin="0,0,0,8" />

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button
          Classes="icon"
          Command="{Binding StepCommand}"
          CommandParameter="prev"
          AutomationProperties.Name="Previous"
          ToolTip.Tip="Previous (Page Up)"
        >
          <PathIcon Data="{v:Icon chevron-left}" />
        </Button>
        <Button
          Content="Today"
          Command="{Binding GoTodayCommand}"
          IsEnabled="{Binding !IsOnToday}"
          AutomationProperties.Name="Go to today"
          ToolTip.Tip="Today (Home)"
        />
        <Button
          Classes="icon"
          Command="{Binding StepCommand}"
          CommandParameter="next"
          AutomationProperties.Name="Next"
          ToolTip.Tip="Next (Page Down)"
        >
          <PathIcon Data="{v:Icon chevron-right}" />
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button
          Content="{Binding TrayLabel}"
          Command="{Binding ToggleTrayCommand}"
          AutomationProperties.Name="Show or hide unscheduled and overdue tasks"
          ToolTip.Tip="Overdue and unscheduled tasks (U)"
        />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <!-- ============ Month ============ -->
      <DockPanel Grid.Column="0" IsVisible="{Binding IsMonth}">
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WeekdayHeaders}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="section" Text="{Binding}" Margin="8,0,0,6" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="panel" ClipToBounds="True">
          <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" Rows="{Binding WeekCount}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SectionViewModel">
                <Border
                  Classes="dayCell"
                  Classes.weekend="{Binding IsWeekend}"
                  Classes.past="{Binding IsPast}"
                  Classes.outside="{Binding IsOutsideMonth}"
                  MinHeight="112"
                  DragDrop.AllowDrop="{Binding IsDropTarget}"
                  DragDrop.DragOver="OnDayDragOver"
                  DragDrop.Drop="OnDayDrop"
                >
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                      <Border Classes="todayDot" IsVisible="{Binding IsToday}" Margin="2,0,2,0" />
                      <Button
                        Grid.Column="1"
                        Classes="dayNum"
                        Classes.today="{Binding IsToday}"
                        Content="{Binding DayNumber}"
                        HorizontalAlignment="Left"
                        Click="OnOpenDay"
                        AutomationProperties.Name="Open week"
                        ToolTip.Tip="Open this week"
                      />
                      <TextBlock
                        Grid.Column="2"
                        Classes="hint"
                        FontSize="11"
                        FontFeatures="+tnum"
                        Text="{Binding LoadText}"
                        IsVisible="{Binding HasLoad}"
                        VerticalAlignment="Center"
                      />
                    </Grid>
                    <Button
                      DockPanel.Dock="Bottom"
                      Classes="link"
                      Content="{Binding HiddenText}"
                      IsVisible="{Binding HasHidden}"
                      HorizontalAlignment="Left"
                      FontSize="11"
                      Click="OnOpenDay"
                    />
                    <ItemsControl ItemsSource="{Binding ShownRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemRowViewModel">
                          <v:CalendarChipView />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </DockPanel>

      <!-- ============ Week: one kanban column per day ============ -->
      <ScrollViewer
        x:Name="WeekScroll"
        Grid.Column="0"
        IsVisible="{Binding IsWeek}"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Disabled"
      >
        <ItemsControl x:Name="WeekGrid" ItemsSource="{Binding Days}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SectionViewModel">
              <Border
                Classes="panel dayCell"
                Classes.weekend="{Binding IsWeekend}"
                Classes.past="{Binding IsPast}"
                Margin="0,0,6,0"
                Padding="8"
                DragDrop.AllowDrop="{Binding IsDropTarget}"
                DragDrop.DragOver="OnDayDragOver"
                DragDrop.Drop="OnDayDrop"
              >
                <DockPanel>
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,8">
                    <Border Classes="todayDot" IsVisible="{Binding IsToday}" Margin="0,0,6,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="headline" Text="{Binding DayNumber}" />
                      <TextBlock
                        Classes="section"
                        Text="{Binding WeekdayLabel}"
                        VerticalAlignment="Center"
                      />
                    </StackPanel>
                    <TextBlock
                      Grid.Column="2"
                      Classes="hint"
                      FontSize="11"
                      FontFeatures="+tnum"
                      Text="{Binding LoadText}"
                      IsVisible="{Binding HasLoad}"
                      VerticalAlignment="Center"
                    />
                  </Grid>
                  <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                  >
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemRowViewModel">
                          <v:ItemRowView />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- ============ Trays: overdue + unscheduled ============ -->
      <ItemsControl
        Grid.Column="1"
        ItemsSource="{Binding Trays}"
        Width="232"
        IsVisible="{Binding TrayVisible}"
      >
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SectionViewModel">
            <Border
              Classes="panel dayCell"
              Margin="0,0,0,10"
              Padding="8"
              MinHeight="96"
              IsVisible="{Binding !IsEmpty}"
              DragDrop.AllowDrop="{Binding IsDropTarget}"
              DragDrop.DragOver="OnDayDragOver"
              DragDrop.Drop="OnDayDrop"
            >
              <DockPanel>
                <TextBlock
                  DockPanel.Dock="Top"
                  Classes="section"
                  Text="{Binding Header}"
                  Margin="6,2,0,8"
                />
                <ScrollViewer
                  MaxHeight="320"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                >
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ItemRowViewModel">
                        <v:ItemRowView />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>
