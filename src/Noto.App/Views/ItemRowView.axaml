<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:v="using:Noto.App.Views"
  xmlns:s="using:Noto.App.Services"
  xmlns:l="using:Noto.App.Logic"
  x:Class="Noto.App.Views.ItemRowView"
  x:DataType="vm:ItemRowViewModel"
>
  <Border
    x:Name="RowRoot"
    Classes="row"
    Classes.focused="{Binding IsFocused}"
    Classes.selected="{Binding IsSelected}"
    AutomationProperties.Name="{Binding AutomationName}"
    ClipToBounds="True"
    PointerPressed="OnPointerPressed"
    DoubleTapped="OnDoubleTapped"
  >
    <Grid ColumnDefinitions="3,Auto,*,Auto,Auto" ColumnSpacing="8">
      <!--
        One 3px bar, not two. Pressure wins over the workspace tick when both apply, so a row never
        shows two adjacent bars whose meanings have to be decoded (docs/07 §10.1).
      -->
      <Panel Grid.Column="0">
        <Border
          Classes="bar"
          Classes.hot="{Binding BarHot}"
          Classes.stale="{Binding BarStale}"
          IsVisible="{Binding ShowBar}"
        />
        <Border
          Width="3"
          CornerRadius="2"
          IsVisible="{Binding HasAccentBar}"
          Background="{Binding WorkspaceAccent, Converter={x:Static v:RowConverters.Accent}}"
        />
      </Panel>

      <!-- status icon doubles as the complete toggle -->
      <Button
        Grid.Column="1"
        Classes="status"
        Classes.aligned="{Binding HasDetailLines}"
        Command="{Binding ToggleCompleteCommand}"
        Focusable="False"
        AutomationProperties.Name="Toggle complete"
        ToolTip.Tip="ring planned · ringed dot Now · dashed ring waiting · solid dot done"
      >
        <v:StatusDot Glyph="{Binding Glyph}" Changed="{Binding GlyphChanged}" />
      </Button>

      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,4" MinWidth="0">
        <TextBlock
          Text="{Binding Breadcrumb}"
          IsVisible="{Binding HasBreadcrumb}"
          Classes="hint"
          FontSize="11"
          TextTrimming="CharacterEllipsis"
        />
        <v:LinkText
          Classes="rowTitle"
          Value="{Binding Title}"
          TextTrimming="CharacterEllipsis"
          IsVisible="{Binding !IsEditing}"
          TextDecorations="{Binding IsDone, Converter={x:Static v:RowConverters.Strike}}"
        />
        <!-- Rows with room (day planner, stacked week) say more under the title: a line of notes, the facts,
             and each linked page. Everything is also in the hover preview. -->
        <v:LinkText
          Classes="secondary"
          Value="{Binding NotesPreview}"
          IsVisible="{Binding ShowNotesLine}"
          FontSize="12"
          Margin="0,1,0,0"
          TextTrimming="CharacterEllipsis"
        />
        <ItemsControl
          ItemsSource="{Binding Chips}"
          IsVisible="{Binding ShowChipsLine}"
          Margin="0,4,0,0"
        >
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="5" LineSpacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="l:RowChip">
              <Border
                Classes="chip fact"
                Classes.late="{Binding IsLate}"
                Classes.due="{Binding IsDue}"
              >
                <TextBlock Text="{Binding Text}" FontSize="11" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl
          ItemsSource="{Binding Links}"
          IsVisible="{Binding ShowLinkChips}"
          Margin="0,4,0,0"
        >
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="5" LineSpacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:LinkLine">
              <Button
                Classes="linkChip"
                Tag="{Binding Url}"
                Click="OnOpenLink"
                AutomationProperties.Name="{Binding AccessibleName, StringFormat='Open {0}'}"
                ToolTip.Tip="{Binding Url}"
              >
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Classes="changed" IsVisible="{Binding HasChange}" />
                  <PathIcon Data="{v:Icon external}" Width="10" Height="10" />
                  <TextBlock
                    Text="{Binding RowText}"
                    FontSize="11"
                    MaxWidth="260"
                    TextTrimming="CharacterEllipsis"
                  />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--
          The one-line link summary. A Grid rather than a horizontal StackPanel: a StackPanel measures its
          children with infinite width, so the TextBlock would stop trimming and a long URL would run past
          the row (docs/07 §15).
        -->
        <Grid
          ColumnDefinitions="Auto,*"
          ColumnSpacing="5"
          IsVisible="{Binding ShowSimpleLink}"
          Cursor="Hand"
          PointerPressed="OnOpenFirstLink"
        >
          <Ellipse Classes="changed" IsVisible="{Binding HasLinkChange}" />
          <TextBlock
            Grid.Column="1"
            Text="{Binding LinkText}"
            Classes="hint link"
            FontSize="12"
            TextTrimming="CharacterEllipsis"
          />
        </Grid>
        <!-- The Timeline layout has no trailing rail, so the due label rides under the title. -->
        <TextBlock
          Text="{Binding ExtraText}"
          IsVisible="{Binding IsTimeline}"
          Classes="hint"
          FontSize="11"
          TextTrimming="CharacterEllipsis"
        />
        <TextBox
          x:Name="EditBox"
          Text="{Binding Owner.EditText, Mode=TwoWay}"
          IsVisible="{Binding IsEditing}"
          v:Behaviors.FocusWhenVisible="True"
          MinHeight="26"
          Padding="6,2"
        />
      </StackPanel>

      <!--
        Timeline strip: a bar from today to the due date, drawn on the same 14-day axis for every row so
        the shapes line up into a timeline (docs/07 §9.1). Only the Timeline layout sets a bar, and an
        Auto column collapses to nothing when it is hidden.
      -->
      <Grid
        Grid.Column="3"
        Width="200"
        Height="16"
        ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*"
        ColumnSpacing="0"
        VerticalAlignment="Center"
        IsVisible="{Binding HasTimelineBar}"
        ToolTip.Tip="{Binding ExtraText}"
      >
        <Border
          Grid.Column="{Binding TimelineStart}"
          Grid.ColumnSpan="{Binding TimelineSpan}"
          CornerRadius="4"
          Background="{DynamicResource AccentBrush}"
          Opacity="0.85"
        />
        <Border
          Grid.Column="{Binding TimelineStart}"
          Grid.ColumnSpan="{Binding TimelineSpan}"
          CornerRadius="4"
          IsVisible="{Binding TimelineOverdue}"
          Background="{DynamicResource PressureHotBrush}"
        />
      </Grid>

      <!--
        Trailing rail, wide layout: fixed-width columns so carry, estimate and priority line up down the
        list instead of smearing into one grey run (docs/07 §10.1).
      -->
      <Grid
        Grid.Column="4"
        ColumnDefinitions="*,Auto,34,56,26"
        ColumnSpacing="8"
        VerticalAlignment="Center"
        IsVisible="{Binding ShowRail}"
      >
        <TextBlock
          Grid.Column="0"
          Text="{Binding ExtraText}"
          IsVisible="{Binding HasExtra}"
          Classes="hint"
          FontSize="12"
          TextTrimming="CharacterEllipsis"
          HorizontalAlignment="Right"
        />
        <!-- "Needs a decision": a quiet ask in the warm ramp, never a red alarm (docs/07 §5). -->
        <Border
          Grid.Column="1"
          Classes="why"
          IsVisible="{Binding IsStuck}"
          ToolTip.Tip="Carried a long time — pick a reason so Noto can help."
        >
          <TextBlock Text="Why?" />
        </Border>
        <StackPanel
          Grid.Column="2"
          Orientation="Horizontal"
          Spacing="3"
          HorizontalAlignment="Right"
          IsVisible="{Binding HasCarry}"
          VerticalAlignment="Center"
          ToolTip.Tip="Carry — planned days that passed undone."
        >
          <PathIcon
            Width="12"
            Height="12"
            Data="{v:Icon carry}"
            Classes="carry"
            Classes.warm="{Binding IsWarm}"
            Classes.hot="{Binding IsHot}"
            Classes.stale="{Binding IsStale}"
          />
          <TextBlock
            Text="{Binding CarryText}"
            Classes="carry"
            Classes.warm="{Binding IsWarm}"
            Classes.hot="{Binding IsHot}"
            Classes.stale="{Binding IsStale}"
          />
        </StackPanel>
        <TextBlock
          Grid.Column="3"
          Text="{Binding EstimateText}"
          IsVisible="{Binding HasEstimate}"
          VerticalAlignment="Center"
          Classes="hint"
          HorizontalAlignment="Right"
        />
        <TextBlock
          Grid.Column="4"
          Text="{Binding PriorityText}"
          IsVisible="{Binding HasPriority}"
          VerticalAlignment="Center"
          Classes="hint"
          HorizontalAlignment="Right"
          ToolTip.Tip="Priority — 1 is highest."
        />
      </Grid>

      <!--
        Trailing rail, compact (board columns): just the ask and the count. A hidden child still
        reserves its grid column, so this is a separate container rather than hidden columns.
      -->
      <StackPanel
        Grid.Column="4"
        Orientation="Horizontal"
        Spacing="6"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        IsVisible="{Binding ShowCompactRail}"
      >
        <TextBlock
          Text="{Binding EstimateText}"
          IsVisible="{Binding ShowNarrowEstimate}"
          Classes="hint"
          FontSize="12"
          VerticalAlignment="Center"
        />
        <Border Classes="why" IsVisible="{Binding IsStuck}">
          <TextBlock Text="Why?" />
        </Border>
        <StackPanel
          Orientation="Horizontal"
          Spacing="3"
          IsVisible="{Binding HasCarry}"
          VerticalAlignment="Center"
          ToolTip.Tip="Carry — planned days that passed undone."
        >
          <PathIcon
            Width="12"
            Height="12"
            Data="{v:Icon carry}"
            Classes="carry"
            Classes.warm="{Binding IsWarm}"
            Classes.hot="{Binding IsHot}"
            Classes.stale="{Binding IsStale}"
          />
          <TextBlock
            Text="{Binding CarryText}"
            Classes="carry"
            Classes.warm="{Binding IsWarm}"
            Classes.hot="{Binding IsHot}"
            Classes.stale="{Binding IsStale}"
          />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
