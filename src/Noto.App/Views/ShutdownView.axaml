<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.ShutdownView"
  x:DataType="vm:ShutdownViewModel"
>
  <ScrollViewer>
    <!-- Same card treatment as the morning review: a step is a card, not a loose column on a page. -->
    <Border
      Classes="panel appear"
      MaxWidth="680"
      Margin="24"
      Padding="28"
      VerticalAlignment="Top"
      HorizontalAlignment="Center"
    >
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding StepLabel}" Classes="section" VerticalAlignment="Center" />
          <Button
            Grid.Column="1"
            Classes="info"
            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenHelpCommand}"
            CommandParameter="{x:Static vm:HelpTopicIds.Shutdown}"
            AutomationProperties.Name="About shutdown"
          >
            <PathIcon Data="{v:Icon info}" />
          </Button>
        </Grid>
        <ProgressBar
          Minimum="0"
          Maximum="1"
          Value="{Binding StepProgress}"
          Height="3"
          AutomationProperties.Name="Shutdown progress"
        />
        <TextBlock Text="{Binding StepTitle}" Classes="displaySmall" TextWrapping="Wrap" />

        <!-- 1. done today -->
        <StackPanel
          Spacing="8"
          IsVisible="{Binding Step, Converter={x:Static v:RowConverters.IsDoneStep}}"
        >
          <ItemsControl ItemsSource="{Binding DoneRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ItemRowViewModel">
                <v:ItemRowView />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button
            Classes="accent"
            Padding="14,6"
            HorizontalAlignment="Left"
            Command="{Binding NextCommand}"
          >
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Continue" VerticalAlignment="Center" />
              <Border Classes="kbd">
                <TextBlock Text="Enter" />
              </Border>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 2. decide what's left -->
        <ContentControl
          IsVisible="{Binding Step, Converter={x:Static v:RowConverters.IsNotDoneStep}}"
          Content="{Binding Review}"
          IsTabStop="False"
          x:Name="ReviewHost"
        />
        <Button
          HorizontalAlignment="Left"
          Command="{Binding NextCommand}"
          IsVisible="{Binding Step, Converter={x:Static v:RowConverters.IsNotDoneStep}}"
        >
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Continue" VerticalAlignment="Center" />
            <Border Classes="kbd">
              <TextBlock Text="Enter" />
            </Border>
          </StackPanel>
        </Button>

        <!-- 3. one line for tomorrow -->
        <StackPanel
          Spacing="8"
          IsVisible="{Binding Step, Converter={x:Static v:RowConverters.IsNoteStep}}"
        >
          <TextBox
            Text="{Binding Note, Mode=TwoWay}"
            Watermark="Anything to remember for tomorrow? (optional)"
            v:Behaviors.FocusWhenVisible="True"
            AutomationProperties.Name="Note for tomorrow"
          />
          <Button
            Classes="accent"
            Content="Finish shutdown"
            HorizontalAlignment="Left"
            Padding="14,6"
            Command="{Binding FinishCommand}"
          />
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
