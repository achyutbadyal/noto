<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.BoardView"
  x:DataType="vm:BoardViewModel"
>
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,8,24,16">
    <v:PromptBar Grid.Row="0" DataContext="{Binding Decisions}" Margin="0,0,0,8" />

    <ScrollViewer
      Grid.Row="1"
      HorizontalScrollBarVisibility="Auto"
      VerticalScrollBarVisibility="Disabled"
    >
      <ItemsControl ItemsSource="{Binding Columns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SectionViewModel">
            <Border
              Classes="panel column appear"
              Width="260"
              MinHeight="120"
              Padding="8"
              Background="{DynamicResource SurfaceBrush}"
              DragDrop.AllowDrop="True"
              DragDrop.DragOver="OnColumnDragOver"
              DragDrop.Drop="OnColumnDrop"
            >
              <DockPanel>
                <TextBlock
                  DockPanel.Dock="Top"
                  Text="{Binding Header}"
                  Classes="section"
                  Margin="6,2,0,8"
                  Classes.carry="{Binding IsOverWip}"
                  Classes.hot="{Binding IsOverWip}"
                />
                <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                >
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ItemRowViewModel">
                        <v:ItemRowView />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- A ghost "+ Column" instead of a raw form bolted under the board (docs/07 §9.1). -->
    <Button
      Grid.Row="2"
      Content="+ Column"
      HorizontalAlignment="Left"
      Margin="0,8,0,0"
      AutomationProperties.Name="Add column"
    >
      <Button.Flyout>
        <Flyout Placement="Top">
          <StackPanel Spacing="8" Width="230">
            <TextBlock Text="New column" Classes="headline" />
            <TextBox
              Text="{Binding NewColumnName, Mode=TwoWay}"
              Watermark="Column name"
              AutomationProperties.Name="New column name"
            />
            <TextBox
              Text="{Binding NewColumnWip, Mode=TwoWay}"
              Watermark="WIP limit (optional)"
              AutomationProperties.Name="WIP limit"
            />
            <Button
              Classes="accent"
              Content="Add column"
              Command="{Binding AddColumnCommand}"
              HorizontalAlignment="Right"
            />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
  </Grid>
</UserControl>
