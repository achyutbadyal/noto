<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:l="using:Noto.App.Logic"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.MainWindow"
  x:DataType="vm:ShellViewModel"
  Title="Noto"
  Width="1240"
  Height="800"
  MinWidth="720"
  MinHeight="480"
  FontFamily="SF Pro Text, Inter, Segoe UI Variable Text, Segoe UI, Helvetica Neue, sans-serif"
  Background="{DynamicResource CanvasBrush}"
  ExtendClientAreaToDecorationsHint="True"
  ExtendClientAreaChromeHints="PreferSystemChrome"
  ExtendClientAreaTitleBarHeightHint="52"
>
  <Panel>
    <Grid ColumnDefinitions="Auto,*,Auto">
      <!-- ===================== Sidebar ===================== -->
      <Border
        Grid.Column="0"
        x:Name="Sidebar"
        Width="{Binding SidebarWidth}"
        Background="{DynamicResource SidebarBrush}"
        BorderBrush="{DynamicResource HairlineBrush}"
        BorderThickness="0,0,1,0"
        ClipToBounds="True"
      >
        <DockPanel LastChildFill="True" Margin="8,0">
          <!-- Top inset keeps the first row clear of the native traffic lights. -->
          <Border DockPanel.Dock="Top" Height="44" Background="Transparent" />

          <StackPanel DockPanel.Dock="Bottom" Spacing="1" Margin="0,0,0,10">
            <Button
              Classes="nav"
              Classes.collapsed="{Binding IsSidebarCollapsed}"
              Classes.selected="{Binding IsTodayAll}"
              Command="{Binding GoToCommand}"
              CommandParameter="TodayAll"
              AutomationProperties.Name="Today, all workspaces"
              ToolTip.Tip="Today across every workspace (⌘0). Workspaces outside their focus hours stay quiet."
            >
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon
                  Data="{v:Icon todayall}"
                  Width="16"
                  Height="16"
                  VerticalAlignment="Center"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="Today (all)"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding EffectiveSidebarExpanded}"
                  TextTrimming="CharacterEllipsis"
                />
              </Grid>
            </Button>
            <Button
              Classes="nav"
              Classes.collapsed="{Binding IsSidebarCollapsed}"
              Command="{Binding StartReviewFromUiCommand}"
              AutomationProperties.Name="Review"
              ToolTip.Tip="Morning review — decide what today holds, one carried item at a time (⌘⇧R). Learn more from the ⓘ in the guide."
            >
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon
                  Data="{v:Icon review}"
                  Width="16"
                  Height="16"
                  VerticalAlignment="Center"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="Review"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding EffectiveSidebarExpanded}"
                  TextTrimming="CharacterEllipsis"
                />
              </Grid>
            </Button>
            <Button
              Classes="nav"
              Classes.collapsed="{Binding IsSidebarCollapsed}"
              Command="{Binding GoToCommand}"
              CommandParameter="WeeklyReview"
              AutomationProperties.Name="Weekly review"
              ToolTip.Tip="Weekly review — sweep what has gone quiet, once a week."
            >
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon
                  Data="{v:Icon weekly}"
                  Width="16"
                  Height="16"
                  VerticalAlignment="Center"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="Weekly review"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding EffectiveSidebarExpanded}"
                  TextTrimming="CharacterEllipsis"
                />
              </Grid>
            </Button>
            <Button
              Classes="nav"
              Classes.collapsed="{Binding IsSidebarCollapsed}"
              Command="{Binding GoToCommand}"
              CommandParameter="Shutdown"
              AutomationProperties.Name="Shutdown"
              ToolTip.Tip="Shutdown — close the day deliberately: what got done, what carries (⌘⇧D)."
            >
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Data="{v:Icon moon}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock
                  Grid.Column="1"
                  Text="Shutdown"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding EffectiveSidebarExpanded}"
                  TextTrimming="CharacterEllipsis"
                />
              </Grid>
            </Button>
            <Button
              Classes="nav"
              Classes.collapsed="{Binding IsSidebarCollapsed}"
              Command="{Binding GoToCommand}"
              CommandParameter="Insights"
              AutomationProperties.Name="Insights"
              ToolTip.Tip="Insights"
            >
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon
                  Data="{v:Icon insights}"
                  Width="16"
                  Height="16"
                  VerticalAlignment="Center"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="Insights"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding EffectiveSidebarExpanded}"
                  TextTrimming="CharacterEllipsis"
                />
              </Grid>
            </Button>
            <Button
              Classes="nav"
              Classes.collapsed="{Binding IsSidebarCollapsed}"
              Command="{Binding GoToCommand}"
              CommandParameter="Settings"
              AutomationProperties.Name="Settings"
              ToolTip.Tip="Settings — the workspace's mode, capacity and day, plus this device's appearance."
            >
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon
                  Data="{v:Icon settings}"
                  Width="16"
                  Height="16"
                  VerticalAlignment="Center"
                />
                <TextBlock
                  Grid.Column="1"
                  Text="Settings"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding EffectiveSidebarExpanded}"
                  TextTrimming="CharacterEllipsis"
                />
              </Grid>
            </Button>
            <Button
              x:Name="GuideNav"
              Classes="nav"
              Classes.collapsed="{Binding IsSidebarCollapsed}"
              Classes.selected="{Binding IsHelp}"
              Command="{Binding OpenHelpCommand}"
              AutomationProperties.Name="Guide"
              ToolTip.Tip="Guide — what every mode, number and button means."
            >
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Data="{v:Icon book}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock
                  Grid.Column="1"
                  Text="Guide"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding EffectiveSidebarExpanded}"
                  TextTrimming="CharacterEllipsis"
                />
              </Grid>
            </Button>
          </StackPanel>

          <StackPanel Spacing="1" Margin="0,0,0,8">
            <TextBlock
              Text="WORKSPACES"
              Classes="section"
              Margin="8,0,0,6"
              IsVisible="{Binding EffectiveSidebarExpanded}"
            />
            <ItemsControl ItemsSource="{Binding Workspaces}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkspaceTabViewModel">
                  <Button
                    Classes="nav wsTab"
                    Padding="0"
                    Classes.collapsed="{Binding $parent[Window].((vm:ShellViewModel)DataContext).IsSidebarCollapsed}"
                    Classes.selected="{Binding IsSelected}"
                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).PickWorkspaceCommand}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding AutomationName}"
                    ToolTip.Tip="{Binding Name}"
                  >
                    <Grid>
                      <!-- Workspace colour tick, pinned to the row's left edge so it lines up with the icons. -->
                      <Border
                        Classes="wsBar"
                        CornerRadius="2"
                        Background="{Binding Color, Converter={x:Static v:RowConverters.Accent}}"
                      />
                      <Grid Classes="wsRow" ColumnDefinitions="Auto,*,Auto">
                        <PathIcon
                          Width="16"
                          Height="16"
                          VerticalAlignment="Center"
                          Data="{Binding Icon, Converter={x:Static v:RowConverters.Icon}}"
                        />
                        <TextBlock
                          Grid.Column="1"
                          Text="{Binding Name}"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis"
                          IsVisible="{Binding $parent[Window].((vm:ShellViewModel)DataContext).EffectiveSidebarExpanded}"
                        />
                        <Border
                          Grid.Column="2"
                          Classes="pill wsBadge"
                          Classes.show="{Binding HasBadge}"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                        >
                          <TextBlock
                            Text="{Binding BadgeText}"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="{DynamicResource Text1Brush}"
                          />
                        </Border>
                      </Grid>
                      <!-- In the rail the count collapses to a dot on the icon. -->
                      <Border
                        Classes="wsDot"
                        Classes.show="{Binding HasBadge}"
                        Width="7"
                        Height="7"
                        CornerRadius="4"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource SidebarBrush}"
                        BorderThickness="1.5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,3,4,0"
                      />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button
              Classes="nav"
              Classes.collapsed="{Binding IsSidebarCollapsed}"
              Margin="0,2,0,0"
              AutomationProperties.Name="New workspace"
              ToolTip.Tip="New workspace"
            >
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Data="{v:Icon plus}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock
                  Grid.Column="1"
                  Text="New workspace"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  Classes="secondary"
                  IsVisible="{Binding EffectiveSidebarExpanded}"
                  TextTrimming="CharacterEllipsis"
                />
              </Grid>
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedTop">
                  <ItemsControl ItemsSource="{Binding Templates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button
                          Content="{Binding}"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NewWorkspaceCommand}"
                          CommandParameter="{Binding}"
                        />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ===================== Main column ===================== -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" ClipToBounds="True">
        <!-- Unified toolbar (lives inside the native title bar) -->
        <Grid Grid.Row="0" Height="52" ColumnDefinitions="Auto,*,Auto" Margin="16,0">
          <StackPanel
            Grid.Column="0"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center"
          >
            <Button
              Classes="icon"
              Command="{Binding ToggleSidebarCommand}"
              AutomationProperties.Name="Toggle sidebar"
              ToolTip.Tip="Toggle sidebar"
            >
              <PathIcon Data="{v:Icon sidebar}" />
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsListPage}">
              <Button
                Classes="icon small"
                Command="{Binding StepDayCommand}"
                CommandParameter="-1"
                AutomationProperties.Name="Previous day"
                ToolTip.Tip="Previous day"
              >
                <PathIcon Data="{v:Icon chevron-left}" />
              </Button>
              <Button
                Classes="icon small"
                Command="{Binding StepDayCommand}"
                CommandParameter="1"
                AutomationProperties.Name="Next day"
                ToolTip.Tip="Next day"
              >
                <PathIcon Data="{v:Icon chevron-right}" />
              </Button>
            </StackPanel>
            <Border Classes="raised" Padding="2" CornerRadius="9" IsVisible="{Binding IsListPage}">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                  Classes="seg"
                  Classes.selected="{Binding IsToday}"
                  Content="Today"
                  Command="{Binding GoToCommand}"
                  CommandParameter="Today"
                />
                <Button
                  Classes="seg"
                  Classes.selected="{Binding IsBacklog}"
                  Content="Backlog"
                  Command="{Binding GoToCommand}"
                  CommandParameter="Backlog"
                />
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock
            Grid.Column="1"
            Text="{Binding HeaderTitle}"
            Classes="headline"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            Margin="12,0"
          />

          <StackPanel
            Grid.Column="2"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center"
          >
            <Border
              Classes="pill"
              Padding="10,4"
              IsVisible="{Binding FocusText, Converter={x:Static ObjectConverters.IsNotNull}}"
            >
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon
                  Data="{v:Icon timer}"
                  Width="13"
                  Height="13"
                  Foreground="{DynamicResource AccentBrush}"
                />
                <TextBlock
                  Text="{Binding FocusText}"
                  FontSize="12"
                  VerticalAlignment="Center"
                  IsVisible="{Binding ShowToolbarLabels}"
                />
              </StackPanel>
            </Border>
            <Button
              Classes="search"
              Command="{Binding OpenCommandBarCommand}"
              AutomationProperties.Name="Command bar"
            >
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{v:Icon search}" Width="13" Height="13" />
                <TextBlock
                  Text="Ask or jump"
                  Classes="hint"
                  VerticalAlignment="Center"
                  IsVisible="{Binding ShowToolbarLabels}"
                />
                <Border
                  Classes="pill"
                  Padding="5,0"
                  Margin="6,0,0,0"
                  IsVisible="{Binding ShowToolbarLabels}"
                >
                  <TextBlock Text="⌘K" FontSize="11" Classes="hint" VerticalAlignment="Center" />
                </Border>
              </StackPanel>
            </Button>
            <Button
              Classes="icon"
              Command="{Binding ShowHelpCommand}"
              AutomationProperties.Name="Keyboard shortcuts"
              ToolTip.Tip="Keyboard shortcuts"
            >
              <PathIcon Data="{v:Icon help}" />
            </Button>
            <Button
              Classes="icon"
              Command="{Binding ToggleInspectorCommand}"
              AutomationProperties.Name="Toggle inspector"
              ToolTip.Tip="Toggle inspector"
            >
              <PathIcon Data="{v:Icon todayall}" />
            </Button>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="hairline" Margin="16,0" />
        <TextBlock
          Grid.Row="2"
          Text="{Binding WeekOutcomes}"
          Classes="secondary"
          Margin="16,8,16,0"
          FontSize="12"
          TextWrapping="Wrap"
          IsVisible="{Binding WeekOutcomes, Converter={x:Static ObjectConverters.IsNotNull}}"
        />

        <ContentControl
          Grid.Row="3"
          x:Name="PageHost"
          Content="{Binding Content}"
          IsTabStop="False"
          ClipToBounds="True"
        />
      </Grid>

      <!-- ===================== Inspector ===================== -->
      <!-- Collapses to zero width (not IsVisible) so its width can animate. -->
      <Border
        Grid.Column="2"
        x:Name="Inspector"
        Width="{Binding ShowInspector, Converter={x:Static v:RowConverters.InspectorWidth}}"
        Opacity="{Binding ShowInspector, Converter={x:Static v:RowConverters.BoolToOpacity}}"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource HairlineBrush}"
        BorderThickness="1,0,0,0"
        ClipToBounds="True"
      >
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="44" Margin="14,0,8,0" ColumnDefinitions="*,Auto">
            <TextBlock Text="INSPECTOR" Classes="section" VerticalAlignment="Center" />
            <Button
              Grid.Column="1"
              Classes="icon small"
              Command="{Binding ToggleInspectorCommand}"
              AutomationProperties.Name="Close inspector"
            >
              <PathIcon Data="{v:Icon close}" Width="14" Height="14" />
            </Button>
          </Grid>
          <Border DockPanel.Dock="Top" Classes="hairline" />
          <v:InspectorView DataContext="{Binding Inspector}" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- Command bar (⌘K): fades + scales in; IsVisible stays true so the transition can run -->
    <Border
      Classes="overlay scrim"
      IsHitTestVisible="{Binding CommandBar.IsOpen}"
      Opacity="{Binding CommandBar.IsOpen, Converter={x:Static v:RowConverters.BoolToOpacity}}"
      Background="#66000000"
      PointerPressed="OnScrimPressed"
    >
      <Border
        x:Name="CommandPanel"
        Classes="panel pop"
        Width="600"
        MaxWidth="640"
        VerticalAlignment="Top"
        Padding="14"
        Margin="{Binding CommandBar.IsOpen, Converter={x:Static v:RowConverters.PanelMargin}}"
        HorizontalAlignment="Center"
        Background="{DynamicResource RaisedBrush}"
        BoxShadow="0 18 50 0 #40000000"
        PointerPressed="OnPanelPressed"
      >
        <StackPanel
          Spacing="10"
          DataContext="{Binding CommandBar}"
          x:DataType="vm:CommandBarViewModel"
        >
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <PathIcon Data="{v:Icon search}" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBox
              Grid.Column="1"
              x:Name="BarBox"
              Text="{Binding Text, Mode=TwoWay}"
              BorderThickness="0"
              Background="Transparent"
              Watermark="Ask or jump…  or type to add: Review PR tomorrow ~30m !2"
              v:Behaviors.FocusWhenVisible="True"
              AutomationProperties.Name="Command bar"
            />
          </Grid>
          <Border Classes="hairline" />
          <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding Chips.Count}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Classes="chip">
                  <TextBlock Text="{Binding}" FontSize="12" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ListBox
            ItemsSource="{Binding Results}"
            SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
            MaxHeight="360"
            AutomationProperties.Name="Results"
          >
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CommandResult">
                <Grid ColumnDefinitions="24,*,Auto" Tapped="OnResultTapped">
                  <PathIcon
                    Data="{Binding Glyph, Converter={x:Static v:RowConverters.Icon}}"
                    VerticalAlignment="Center"
                    Width="15"
                    Height="15"
                  />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      Text="{Binding Detail}"
                      Classes="hint"
                      FontSize="12"
                      IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                    />
                  </StackPanel>
                  <TextBlock
                    Grid.Column="2"
                    Text="{Binding Shortcut}"
                    Classes="hint"
                    VerticalAlignment="Center"
                  />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Border>

    <!-- Keyboard help (?) -->
    <Border
      Classes="overlay scrim"
      IsHitTestVisible="{Binding IsHelpOpen}"
      Opacity="{Binding IsHelpOpen, Converter={x:Static v:RowConverters.BoolToOpacity}}"
      Background="#66000000"
      PointerPressed="OnHelpScrimPressed"
    >
      <Border
        x:Name="HelpPanel"
        Classes="panel pop"
        Width="660"
        MaxWidth="700"
        MaxHeight="640"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Padding="22"
        Background="{DynamicResource RaisedBrush}"
        BoxShadow="0 18 50 0 #40000000"
        PointerPressed="OnPanelPressed"
      >
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <TextBlock Text="Keyboard shortcuts" Classes="title" VerticalAlignment="Center" />
            <Button
              Grid.Column="1"
              Classes="icon small"
              Command="{Binding CloseHelpCommand}"
              AutomationProperties.Name="Close"
            >
              <PathIcon Data="{v:Icon close}" Width="14" Height="14" />
            </Button>
          </Grid>
          <Border DockPanel.Dock="Top" Classes="hairline" Margin="0,0,0,12" />
          <StackPanel
            DockPanel.Dock="Bottom"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,12,0,0"
          >
            <TextBlock
              Text="Not sure what a mode or a number means?"
              Classes="secondary"
              VerticalAlignment="Center"
            />
            <Button
              Classes="link"
              Content="Open the guide"
              Command="{Binding OpenHelpCommand}"
              CommandParameter="{x:Static vm:HelpTopicIds.Start}"
            />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Shortcuts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="l:Binding">
                  <Grid ColumnDefinitions="120,*,Auto" Margin="0,3">
                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Classes="mono" />
                    <TextBlock Grid.Column="1" Text="{Binding Description}" />
                    <TextBlock Grid.Column="2" Text="{Binding Scope}" Classes="hint" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- Undo toast: no confirmation dialogs, every action is undoable -->
    <Border
      Classes="panel toast"
      IsHitTestVisible="{Binding Toast.IsVisible}"
      Opacity="{Binding Toast.IsVisible, Converter={x:Static v:RowConverters.BoolToOpacity}}"
      Margin="{Binding Toast.IsVisible, Converter={x:Static v:RowConverters.ToastMargin}}"
      Background="{DynamicResource RaisedBrush}"
      VerticalAlignment="Bottom"
      HorizontalAlignment="Center"
      Padding="16,10"
      CornerRadius="999"
      BoxShadow="0 8 24 0 #33000000"
      AutomationProperties.Name="{Binding Toast.Message}"
    >
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding Toast.Message}" VerticalAlignment="Center" />
        <Button
          Classes="link"
          Content="Undo  ⌘Z"
          Command="{Binding Toast.UndoCommand}"
          IsVisible="{Binding Toast.CanUndo}"
        />
        <Button
          Classes="icon small"
          Command="{Binding Toast.DismissCommand}"
          AutomationProperties.Name="Dismiss"
        >
          <PathIcon Data="{v:Icon close}" Width="13" Height="13" />
        </Button>
      </StackPanel>
    </Border>
  </Panel>
</Window>
