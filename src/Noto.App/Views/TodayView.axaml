<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Noto.App.ViewModels"
  xmlns:v="using:Noto.App.Views"
  x:Class="Noto.App.Views.TodayView"
  x:DataType="vm:TodayViewModel"
>
  <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="24,12,24,16">
      <!-- carry-over banner -->
      <Border
        Grid.Row="0"
        Classes="raised appear"
        Padding="12,8"
        Margin="0,0,0,12"
        IsVisible="{Binding BannerText, Converter={x:Static ObjectConverters.IsNotNull}}"
      >
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button
            Grid.Column="1"
            Classes="accent"
            Padding="12,4"
            VerticalAlignment="Center"
            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).StartReviewFromUiCommand}"
          >
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Review" VerticalAlignment="Center" />
              <Border Classes="kbd">
                <TextBlock Text="⌘⇧R" />
              </Border>
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- 14-day completion strip: scrolls horizontally so it never clips on a narrow window -->
      <ScrollViewer
        Grid.Row="1"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Disabled"
        Margin="0,0,0,12"
        ToolTip.Tip="Bar height is how much you finished. Click a day to open its log."
      >
        <ItemsControl ItemsSource="{Binding Strip.Bars}" AutomationProperties.Name="Last 14 days">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DayBarViewModel">
              <Button
                Padding="2"
                Height="46"
                VerticalContentAlignment="Bottom"
                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).PickDayCommand}"
                CommandParameter="{Binding}"
                ToolTip.Tip="{Binding Tooltip}"
                AutomationProperties.Name="{Binding AutomationName}"
              >
                <!--
                  Bar, then a 1px tick. Every tick sits at the same height, so together they form a
                  baseline: a day with nothing planned reads as zero on an axis, not a stray dash.
                -->
                <StackPanel Spacing="3" VerticalAlignment="Bottom">
                  <Border
                    Width="18"
                    Height="{Binding Height}"
                    CornerRadius="3"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource AccentBrush}"
                    Opacity="{Binding IsToday, Converter={x:Static v:RowConverters.TodayOpacity}}"
                  />
                  <Border Width="18" Height="1" Background="{DynamicResource HairlineBrush}" />
                  <TextBlock
                    Text="{Binding Label}"
                    FontSize="10"
                    Classes="hint"
                    HorizontalAlignment="Center"
                  />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- capacity bar and pace forecast -->
      <StackPanel Grid.Row="2" Margin="0,0,0,16" Spacing="4">
        <Grid
          ColumnDefinitions="Auto,*,Auto,Auto,Auto"
          ColumnSpacing="12"
          IsVisible="{Binding Capacity, Converter={x:Static ObjectConverters.IsNotNull}}"
        >
          <TextBlock Text="Capacity" Classes="secondary" VerticalAlignment="Center" />
          <ProgressBar
            Grid.Column="1"
            Minimum="0"
            Maximum="100"
            Value="{Binding Capacity.Percent}"
            MinWidth="80"
            Classes.over="{Binding Capacity.IsOver}"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding Capacity.AutomationName}"
          />
          <TextBlock
            Grid.Column="2"
            Text="{Binding Capacity.Text}"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
          />
          <TextBlock
            Grid.Column="3"
            Text="{Binding Capacity.StatusText}"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
          />
          <Button
            Grid.Column="4"
            Classes="info"
            VerticalAlignment="Center"
            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenHelpCommand}"
            CommandParameter="{x:Static vm:HelpTopicIds.Workspaces}"
            AutomationProperties.Name="About capacity"
          >
            <PathIcon Data="{v:Icon info}" />
          </Button>
        </Grid>
        <WrapPanel Orientation="Horizontal">
          <Button
            Classes="link"
            Content="{Binding Capacity.SuggestText}"
            Command="{Binding ApplyDeferCommand}"
            Padding="0"
            Margin="0,0,12,0"
            IsVisible="{Binding Capacity.HasSuggestion}"
          />
          <TextBlock
            Text="{Binding Capacity.Footnote}"
            Classes="hint"
            FontSize="11"
            TextWrapping="Wrap"
            IsVisible="{Binding Capacity.Footnote, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
        </WrapPanel>
        <TextBlock
          Text="{Binding ForecastText}"
          Classes="secondary"
          TextWrapping="Wrap"
          IsVisible="{Binding ForecastText, Converter={x:Static ObjectConverters.IsNotNull}}"
        />
      </StackPanel>

      <v:PromptBar Grid.Row="3" DataContext="{Binding Decisions}" Margin="0,0,0,12" />

      <Panel Grid.Row="4">
        <v:SectionsList DataContext="{Binding}" />
        <TextBlock
          Text="{Binding EmptyText}"
          Classes="secondary"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          TextWrapping="Wrap"
          TextAlignment="Center"
          IsVisible="{Binding IsEmpty}"
        />
      </Panel>

      <!-- capture: one composer holding the title, the duration and the actions, so it reads as a
           single control instead of a row of loose buttons -->
      <StackPanel Grid.Row="5" Spacing="4" Margin="0,8,0,0">
        <Border x:Name="CaptureBar" Classes="composer" Padding="6">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding Add.Chips}" IsVisible="{Binding Add.Chips.Count}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Classes="chip">
                    <TextBlock Text="{Binding}" FontSize="12" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
              <Panel Grid.Column="0">
                <TextBlock x:Name="AddHighlight" Classes="mirror" />
                <TextBox
                  x:Name="AddBox"
                  Classes="bare"
                  Foreground="Transparent"
                  CaretBrush="{DynamicResource Text1Brush}"
                  Text="{Binding Add.Text, Mode=TwoWay}"
                  Watermark="New task…"
                  AutomationProperties.Name="New task title"
                  KeyDown="OnAddKeyDown"
                />
              </Panel>
              <ComboBox
                Grid.Column="1"
                Width="126"
                ItemsSource="{Binding Add.Estimates}"
                SelectedItem="{Binding Add.Estimate, Mode=TwoWay}"
                AutomationProperties.Name="Estimate"
              />
              <Button
                Grid.Column="2"
                Classes="accent"
                Content="Add"
                MinWidth="68"
                Command="{Binding Add.AddCommand}"
              />
              <Button
                Grid.Column="3"
                Content="More options"
                Command="{Binding Add.OpenDetailedCommand}"
              />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock
          Text="{Binding Add.Error}"
          Classes="error"
          Margin="8,0,0,0"
          IsVisible="{Binding Add.Error, Converter={x:Static ObjectConverters.IsNotNull}}"
        />
      </StackPanel>
    </Grid>

    <!-- Detailed create: every field the domain supports. It sits outside the page margins so the
         panel's shadow has room and is not clipped by the page bounds. -->
    <Panel x:Name="DetailedPanel" IsVisible="{Binding Add.IsDetailedOpen}" ZIndex="10">
      <Border Background="#66000000" PointerPressed="OnDetailedScrimPressed" />
      <Border
        Classes="panel pop"
        Width="500"
        MaxWidth="540"
        MaxHeight="560"
        Margin="32"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="20"
        Background="{DynamicResource RaisedBrush}"
        BoxShadow="0 6 20 0 #40000000"
      >
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="2">
              <TextBlock Text="New task" Classes="title" />
              <TextBlock
                Text="{Binding WorkspaceName, StringFormat='Adding to {0}'}"
                Classes="hint"
              />
            </StackPanel>
            <Button
              Grid.Column="1"
              Classes="icon small"
              Command="{Binding Add.CloseDetailedCommand}"
              AutomationProperties.Name="Close"
            >
              <PathIcon Data="{v:Icon close}" Width="14" Height="14" />
            </Button>
          </Grid>

          <Border DockPanel.Dock="Top" Classes="hairline" Margin="0,0,0,14" />

          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,14,0,0">
            <TextBlock
              Text="{Binding Add.DetailError}"
              Classes="error"
              IsVisible="{Binding Add.DetailError, Converter={x:Static ObjectConverters.IsNotNull}}"
            />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Cancel (Esc)" Command="{Binding Add.CloseDetailedCommand}" />
              <Button
                Classes="accent"
                Content="Add task"
                Padding="14,6"
                Command="{Binding Add.DetailSubmitCommand}"
              />
            </StackPanel>
          </StackPanel>

          <ScrollViewer>
            <StackPanel Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="TITLE" Classes="section" />
                <TextBox
                  x:Name="DetailTitleBox"
                  Text="{Binding Add.DetailTitle, Mode=TwoWay}"
                  Watermark="What needs doing?"
                  v:Behaviors.FocusWhenVisible="True"
                  KeyDown="OnDetailKeyDown"
                  AutomationProperties.Name="Task title"
                />
              </StackPanel>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="TIME" Classes="section" />
                  <ComboBox
                    ItemsSource="{Binding Add.Estimates}"
                    SelectedItem="{Binding Add.DetailEstimate, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Estimate"
                  />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="PRIORITY" Classes="section" />
                  <ComboBox
                    ItemsSource="{Binding Add.Priorities}"
                    SelectedItem="{Binding Add.DetailPriority, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Priority"
                  />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="4" Margin="0,10,0,0">
                  <TextBlock Text="WHEN" Classes="section" />
                  <ComboBox
                    ItemsSource="{Binding Add.Whens}"
                    SelectedItem="{Binding Add.DetailWhen, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="When"
                  />
                  <TextBlock Text="{Binding Add.DetailWhenPreview}" Classes="hint" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,10,0,0">
                  <TextBlock Text="DUE" Classes="section" />
                  <ComboBox
                    ItemsSource="{Binding Add.Dues}"
                    SelectedItem="{Binding Add.DetailDue, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Due date"
                  />
                  <TextBlock Text="{Binding Add.DetailDuePreview}" Classes="hint" FontSize="11" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="TIME OF DAY" Classes="section" />
                  <ComboBox
                    ItemsSource="{Binding Add.TimesOfDay}"
                    SelectedItem="{Binding Add.DetailTime, Mode=TwoWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Time of day"
                  />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="WAITING ON" Classes="section" />
                  <TextBox
                    Text="{Binding Add.DetailWaitingOn, Mode=TwoWay}"
                    Watermark="Name (optional)"
                    AutomationProperties.Name="Waiting on"
                  />
                </StackPanel>
              </Grid>

              <StackPanel Spacing="4">
                <TextBlock Text="NOTES" Classes="section" />
                <TextBox
                  Text="{Binding Add.DetailNotes, Mode=TwoWay}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  MinHeight="64"
                  Watermark="Markdown notes (optional)"
                  AutomationProperties.Name="Notes"
                />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>
</UserControl>
