<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noto.App.ViewModels"
             xmlns:v="using:Noto.App.Views"
             x:Class="Noto.App.Views.ListPageView"
             x:DataType="vm:ItemListViewModel">
  <!-- Plain sectioned list: Timeline lanes and anything else without extra chrome -->
  <Grid RowDefinitions="Auto,*" Margin="24,8,24,16">
    <v:PromptBar Grid.Row="0" DataContext="{Binding Decisions}" Margin="0,0,0,8" />
    <v:SectionsList Grid.Row="1" DataContext="{Binding}" />
  </Grid>
</UserControl>
