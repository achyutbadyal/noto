<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Noto.App.ViewModels"
             xmlns:v="using:Noto.App.Views"
             x:Class="Noto.App.Views.TodayAllView"
             x:DataType="vm:TodayAllViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,8,24,16">
    <TextBlock Grid.Row="0" Text="{Binding BannerText}" Classes="secondary" Margin="0,0,0,6" IsVisible="{Binding BannerText, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Grid.Row="1" Text="{Binding CapacityText}" Margin="0,0,0,6" IsVisible="{Binding CapacityText, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <TextBlock Grid.Row="2" Text="{Binding QuietText}" Classes="hint" Margin="0,0,0,10" IsVisible="{Binding QuietText, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <Grid Grid.Row="3" RowDefinitions="Auto,*">
      <v:PromptBar DataContext="{Binding Decisions}" Margin="0,0,0,8" />
      <v:SectionsList Grid.Row="1" DataContext="{Binding}" />
    </Grid>
  </Grid>
</UserControl>
