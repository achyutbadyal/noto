<Styles
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:anim="using:Avalonia.Animation.Easings"
>
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Motion tokens: exponential curves, never bounce/elastic (docs: motion-design). -->
      <anim:CubicEaseOut x:Key="EaseOut" />
      <anim:CubicEaseInOut x:Key="EaseInOut" />
      <anim:ExponentialEaseOut x:Key="EaseOutExpo" />

      <!--
        Fluent's dropdown state brushes are translucent overlays, so a hovered dropdown went grey-on-white
        in light and near-black in dark. A Styles block later in the collection wins the resource lookup,
        so repoint every state at our own palette. The values mirror ThemeTokens (ControlStyleTests pins
        the rendered hover to HoverBrush, so they cannot drift).
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#232120" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#322E2A" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2C2825" />
          <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#232120" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2C2825" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#2C2825" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#2C2825" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#232120" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2C2825" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#322E2A" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#322E2A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#F1EDE6" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#EBE6DC" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E0DACE" />
          <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F1EDE6" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#E0DACE" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#E0DACE" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#E0DACE" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F1EDE6" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E0DACE" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#EBE6DC" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#EBE6DC" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ============================================================= -->
  <!--  Typography: system UI stack, tabular numerals for counts     -->
  <!-- ============================================================= -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>
  <Style Selector="TextBlock.headline">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.1" />
  </Style>
  <!--
    The one loud element on a page: a display day header in an editorial face, so content outranks
    chrome. No font is bundled — the stack falls back to a system serif (docs/07 §11.2).
  -->
  <Style Selector="TextBlock.display">
    <Setter
      Property="FontFamily"
      Value="Newsreader, Fraunces, Iowan Old Style, Palatino, Georgia, serif"
    />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>
  <Style Selector="TextBlock.displaySmall">
    <Setter
      Property="FontFamily"
      Value="Newsreader, Fraunces, Iowan Old Style, Palatino, Georgia, serif"
    />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- Row titles outrank chrome: 14px medium, up from 13px. -->
  <Style Selector="TextBlock.rowTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource PressureStaleBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="SF Mono, Menlo, Consolas, monospace" />
  </Style>

  <!-- Pressure: static signals, never colour alone (the glyph and text carry the meaning too) -->
  <Style Selector="TextBlock.carry.warm">
    <Setter Property="Foreground" Value="{DynamicResource PressureWarmBrush}" />
  </Style>
  <Style Selector="TextBlock.carry.hot">
    <Setter Property="Foreground" Value="{DynamicResource PressureHotBrush}" />
  </Style>
  <Style Selector="TextBlock.carry.stale">
    <Setter Property="Foreground" Value="{DynamicResource PressureStaleBrush}" />
  </Style>
  <Style Selector="Border.bar">
    <Setter Property="Width" Value="3" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.bar.hot">
    <Setter Property="Background" Value="{DynamicResource PressureHotBrush}" />
  </Style>
  <Style Selector="Border.bar.stale">
    <Setter Property="Background" Value="{DynamicResource PressureStaleBrush}" />
  </Style>
  <Style Selector="PathIcon.carry.warm">
    <Setter Property="Foreground" Value="{DynamicResource PressureWarmBrush}" />
  </Style>
  <Style Selector="PathIcon.carry.hot">
    <Setter Property="Foreground" Value="{DynamicResource PressureHotBrush}" />
  </Style>
  <Style Selector="PathIcon.carry.stale">
    <Setter Property="Foreground" Value="{DynamicResource PressureStaleBrush}" />
  </Style>

  <!-- ============================================================= -->
  <!--  Icons                                                         -->
  <!-- ============================================================= -->
  <Style Selector="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="PathIcon.large">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="PathIcon.strong">
    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
  </Style>
  <Style Selector="PathIcon.done">
    <Setter Property="Foreground" Value="{DynamicResource DoneBrush}" />
  </Style>
  <!-- Completing an item fills its glyph rather than snapping (docs/07 §11.3). -->
  <Style Selector="Window.motion PathIcon.done">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition
          Property="Foreground"
          Duration="0:0:0.6"
          Easing="{StaticResource EaseOut}"
        />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="PathIcon.now">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="PathIcon.waiting">
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
  </Style>
  <Style Selector="PathIcon.dropped">
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
  </Style>

  <!-- Status icon doubles as the complete toggle -->
  <Style Selector="Button.status">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.status /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.status:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>

  <!-- ============================================================= -->
  <!--  Surfaces                                                      -->
  <!-- ============================================================= -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.raised">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,2" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <!--
    "Needs a decision". A quiet ask in the warm end of the ramp — never a red outlined alarm, which
    read as an error and contradicted the "honest, not harsh" principle (docs/07 §5).
  -->
  <Style Selector="Border.why">
    <Setter Property="Background" Value="{DynamicResource PressureWarmSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.why TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource PressureWarmBrush}" />
  </Style>
  <!-- A keyboard hint is a chip, not bare "⌘K" text floating in the layout. -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontFamily" Value="SF Mono, Menlo, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Board column under a dragged card: the accent edge is the drop affordance. -->
  <Style Selector="Border.column:dragover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Habit week grid: rounded squares, never coloured crosses -->
  <Style Selector="Button.habitCell">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.habitCell /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.habitCell:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Border.habit">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.habit.done">
    <Setter Property="Background" Value="{DynamicResource DoneBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.habit.off">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <!-- ============================================================= -->
  <!--  Rows                                                          -->
  <!-- ============================================================= -->
  <Style Selector="Border.row">
    <Setter Property="MinHeight" Value="{DynamicResource RowHeight}" />
    <Setter Property="Padding" Value="0,0,10,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.row.focused">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Border.row.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Border.row:pointerover TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="Border.row:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>

  <!-- ============================================================= -->
  <!--  Buttons                                                       -->
  <!-- ============================================================= -->
  <Style Selector="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!--
    A visible focus ring for keyboard users. The border is already 1px everywhere, so recolouring it
    gives a clear ring without reflowing the layout (docs/07 §15).
  -->
  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
  </Style>
  <Style Selector="Button:focus-visible Border">
    <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
  </Style>
  <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
  </Style>
  <Style Selector="ToggleSwitch:focus-visible /template/ Border#SwitchKnobBounds">
    <Setter Property="BorderBrush" Value="{DynamicResource LinkBrush}" />
  </Style>

  <!-- Primary action: filled with the workspace accent -->
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource CanvasBrush}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.accent PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource CanvasBrush}" />
  </Style>

  <!-- Keyboard-decision card (review + prompts) -->
  <Style Selector="Button.key /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.key:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- Icon-only button: square, quiet, circular hover -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <!-- ⓘ "learn more": a quiet affordance that deep-links into the guide -->
  <Style Selector="Button.info">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.info PathIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
  </Style>
  <Style Selector="Button.info:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
  </Style>
  <Style Selector="Button.info:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- Sidebar / navigation item -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
  </Style>
  <Style Selector="Button.nav PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="Button.nav.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.nav.selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.nav.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
  </Style>

  <!-- Collapsed rail: no padding, so the single remaining icon centres exactly in the 40px button. -->
  <Style Selector="Button.nav.collapsed">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0,6" />
  </Style>

  <!-- Workspace row: colour tick (selected only) at the left edge, then icon / name / count. -->
  <Style Selector="Border.wsBar">
    <Setter Property="Width" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,5,0,5" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.wsDot">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.wsBadge">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Only one rule ever turns visibility on, guarded by the sidebar state, so nothing depends on
       selector-specificity ordering. -->
  <Style Selector="Button.wsTab.selected:not(.collapsed) Border.wsBar">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.wsTab:not(.collapsed) Border.wsBadge.show">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.wsTab.collapsed Border.wsDot.show">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Collapsed workspace tab: keep the button full width so the dot can sit in its corner, and centre the icon. -->
  <Style Selector="Button.wsTab.collapsed">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Grid.wsRow">
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- The two states are mutually exclusive, so neither rule has to out-specify the other. -->
  <Style Selector="Button.wsTab:not(.collapsed) Grid.wsRow">
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.wsTab.collapsed Grid.wsRow">
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Segmented control -->
  <Style Selector="Button.seg">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="Button.seg /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.seg.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="Button.seg.selected">
    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource PressureStaleBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- Capture composer: one surface holding the field, the duration and the actions, so the bar reads
       as a single control rather than a row of loose buttons. -->
  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.composer:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Window.motion Border.composer">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition
          Property="BorderBrush"
          Duration="0:0:0.13"
          Easing="{StaticResource EaseOut}"
        />
      </Transitions>
    </Setter>
  </Style>
  <!-- The composer owns the surface, so the field inside it is borderless -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <!--
    Mirror behind a transparent capture field. A TextBox cannot style runs, so recognised tokens are
    drawn by a TextBlock and the field itself renders transparent text (docs/07 §7.1). Same padding as
    TextBox.bare, so the two align.
  -->
  <Style Selector="TextBlock.mirror">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!--
    The borderless-field overrides live further down, AFTER the generic `TextBox:pointerover/:focus`
    rules below. Avalonia resolves competing `/template/` styles in document order, so a `.bare`
    override declared here would lose to the generic rule that follows and the field's inner border
    would paint an opaque surface over the mirror (the capture text would vanish on hover/focus).
  -->
  <!-- Inside the composer the dropdown is a quiet chip, not a second boxed control -->
  <Style Selector="Border.composer ComboBox">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.composer ComboBox /template/ Border#Background">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    Read-first fields. A value should read as text until you touch it: the inspector shows the current
    value, and the control only announces itself on hover or focus (docs/07 §10.2).
  -->
  <Style Selector="ComboBox.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBox.quiet /template/ Border#Background">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox.quiet:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ComboBox.quiet:focus /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <Style Selector="TextBox.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="TextBox.quiet /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.quiet:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.quiet:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Accent swatch: the colour is the label, and the ring marks the current one. -->
  <Style Selector="Button.swatch">
    <Setter Property="Padding" Value="3" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.swatch /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
  </Style>
  <Style Selector="Button.swatch.selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Text1Brush}" />
  </Style>
  <Style Selector="Border.swatchDot">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- macOS-style search field -->
  <Style Selector="Button.search">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinWidth" Value="190" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.search /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
  </Style>
  <Style Selector="Button.search:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Text3Brush}" />
  </Style>

  <!-- ============================================================= -->
  <!--  Inputs                                                        -->
  <!-- ============================================================= -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Text1Brush}" />
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_Placeholder">
    <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!--
    The borderless capture field (docs/07 §7.1). These MUST come after the two generic state rules
    above: Avalonia resolves competing `/template/` setters in document order, so the generic
    `:pointerover`/`:focus` backgrounds would otherwise repaint the field's inner border opaque and
    hide the mirror TextBlock behind it — the typed title would go invisible on hover or focus.
  -->
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Fluent's own dropdown state brushes are translucent overlays (see ThemeBuilder.DropdownOverrides,
       which repoints the resource keys at our tokens); these styles cover shape and the popup list. -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="9,4" />
  </Style>
  <Style Selector="ComboBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource Text1Brush}" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="MaxHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ProgressBar.over">
    <Setter Property="Foreground" Value="{DynamicResource PressureHotBrush}" />
  </Style>

  <!-- ============================================================= -->
  <!--  Lists                                                         -->
  <!-- ============================================================= -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- Guide topic rail: tighter rows than a generic list -->
  <Style Selector="ListBox.guide ListBoxItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <!-- Tooltips: raised surface, readable, never wider than a sentence or two -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ============================================================= -->
  <!--  Motion: only when the OS isn't asking for reduced motion      -->
  <!--  (the window adds the "motion" class). Only transform + opacity -->
  <!--  are animated; easing is exponential, never bounce.            -->
  <!-- ============================================================= -->

  <!-- Micro-interactions: colour feedback on hover/press (100-150ms) -->
  <Style Selector="Window.motion Button">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition
          Property="Background"
          Duration="0:0:0.13"
          Easing="{StaticResource EaseOut}"
        />
        <DoubleTransition
          Property="Opacity"
          Duration="0:0:0.13"
          Easing="{StaticResource EaseOut}"
        />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.motion Border.row">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition
          Property="Background"
          Duration="0:0:0.14"
          Easing="{StaticResource EaseOut}"
        />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.motion ListBoxItem">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition
          Property="Background"
          Duration="0:0:0.14"
          Easing="{StaticResource EaseOut}"
        />
      </Transitions>
    </Setter>
  </Style>

  <!-- Progress: value eases rather than jumping (260ms) -->
  <Style Selector="Window.motion ProgressBar">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Value" Duration="0:0:0.26" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Sidebar collapse and inspector slide (260ms, ease-in-out for a there-and-back toggle) -->
  <Style Selector="Window.motion Border#Sidebar">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Width"
          Duration="0:0:0.26"
          Easing="{StaticResource EaseInOut}"
        />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.motion Border#Inspector">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Width"
          Duration="0:0:0.26"
          Easing="{StaticResource EaseInOut}"
        />
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Overlays: fade the scrim, then fade + scale the panel (enter 200ms, exit faster) -->
  <Style Selector="Window.motion Border.scrim">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="0:0:0.15"
          Easing="{StaticResource EaseOut}"
        />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.motion Border.pop">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="0:0:0.16"
          Easing="{StaticResource EaseOut}"
        />
        <ThicknessTransition
          Property="Margin"
          Duration="0:0:0.2"
          Easing="{StaticResource EaseOutExpo}"
        />
      </Transitions>
    </Setter>
  </Style>

  <!-- Toast -->
  <Style Selector="Window.motion Border.toast">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="0:0:0.18"
          Easing="{StaticResource EaseOut}"
        />
        <ThicknessTransition
          Property="Margin"
          Duration="0:0:0.22"
          Easing="{StaticResource EaseOutExpo}"
        />
      </Transitions>
    </Setter>
  </Style>

  <!-- Section disclosure chevron: rotates as the section collapses (keyframe, class-driven) -->
  <Style Selector="PathIcon.chevron">
    <Setter Property="RenderTransform">
      <RotateTransform Angle="0" />
    </Setter>
  </Style>
  <Style Selector="PathIcon.chevron.collapsed">
    <Setter Property="RenderTransform">
      <RotateTransform Angle="-90" />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="{StaticResource EaseInOut}">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="-90" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="PathIcon.chevron:not(.collapsed)">
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="{StaticResource EaseInOut}">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="-90" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Section body fades/settles as it collapses (height itself stays instant: no layout animation) -->
  <Style Selector="ItemsControl.sectionBody">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ItemsControl.sectionBody.collapsed">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Window.motion ItemsControl.sectionBody">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="0:0:0.16"
          Easing="{StaticResource EaseOut}"
        />
      </Transitions>
    </Setter>
  </Style>

  <!-- Review card: leaves toward the decision (←defer, ↑someday, ↓drop, →today) -->
  <Style Selector="Window.motion Border.exit">
    <Setter Property="Transitions">
      <Transitions>
        <ThicknessTransition
          Property="Margin"
          Duration="0:0:0.18"
          Easing="{StaticResource EaseOutExpo}"
        />
        <DoubleTransition
          Property="Opacity"
          Duration="0:0:0.18"
          Easing="{StaticResource EaseOut}"
        />
      </Transitions>
    </Setter>
  </Style>

  <!-- Cards / rows settling in when a page appears -->
  <Style Selector="Window.motion Border.appear">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="0:0:0.24"
          Easing="{StaticResource EaseOut}"
        />
        <ThicknessTransition
          Property="Margin"
          Duration="0:0:0.28"
          Easing="{StaticResource EaseOutExpo}"
        />
      </Transitions>
    </Setter>
  </Style>

  <!-- Page swap: the new page fades in (code-behind sets 0 then 1); no cross-fade ghosting -->
  <Style Selector="Window.motion ContentControl#PageHost">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition
          Property="Opacity"
          Duration="0:0:0.18"
          Easing="{StaticResource EaseOut}"
        />
      </Transitions>
    </Setter>
  </Style>
</Styles>
