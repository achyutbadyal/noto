# Copy to .env and fill in. The sync server reads the first .env it finds in the current directory, then in
# the parent folders of the binary, so `mise exec -- dotnet run --project src/Noto.Server` finds the repo-root file.
# Real environment variables override values in this file.
# Relative paths such as DATA_DIR resolve against the current directory; under `dotnet run` that is
# src/Noto.Server, so prefer an absolute path there.

# --- Required -------------------------------------------------------------
# Signs access tokens. At least 32 characters. Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=
# Absolute http(s) URL of the server. Used to build OAuth callback URLs.
PUBLIC_URL=http://localhost:8080

# --- Storage --------------------------------------------------------------
# Leave DATABASE_URL empty to use SQLite under DATA_DIR.
# DATABASE_URL=postgresql://noto:change-me@localhost:5432/noto
# DB=sqlite
# DATA_DIR=/absolute/path/to/noto-data  (default ./noto-data)
# PORT=8080

# --- Sign-up --------------------------------------------------------------
# closed (default): nobody can create an account. invite: sign-up needs a code from INVITE_CODES.
# open: anyone who can reach the server can sign up.
# To bootstrap a fresh server, set REGISTRATION=invite, create your account, then switch back to closed.
REGISTRATION=closed
# Comma-separated, each at least 16 characters. Generate one with: openssl rand -hex 16
# INVITE_CODES=

# --- Browser access -------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
# CORS_ORIGINS=http://localhost:5173

# --- Connected apps (optional) -------------------------------------------
# Register an OAuth app per provider; each callback is $PUBLIC_URL/v1/gateway/oauth/<provider>/callback.
# Step-by-step setup: docs/12-connected-apps-setup.md
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=

# Self-hosted hosts on your network the gateway may reach (e.g. on-prem Jira).
# GATEWAY_ALLOW_PRIVATE_HOSTS=jira.acme.internal

# --- Docker compose (src/Noto.Server/docker-compose.yml) ------------------
# Compose reads .env from its own directory, so copy this file to src/Noto.Server/.env as well.
# POSTGRES_PASSWORD=change-me

# --- Tuning (optional, defaults in src/Noto.Server/Config/ServerConfig.cs) -
# RATE_AUTH_PER_MIN=10
# RATE_SYNC_PER_MIN=60
# ARGON2_MEMORY_KB=65536
# TRUST_PROXY=false
